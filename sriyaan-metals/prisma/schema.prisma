generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("CONTENT_MANAGER")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String    @default("")
  image          String    @default("")
  published      Boolean   @default(true)
  sortOrder      Int       @default(0)
  seoTitle       String    @default("")
  seoDescription String    @default("")
  products       Product[]
}

model Product {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  sku            String    @unique
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  description    String    @default("")
  standard       String    @default("")
  material       String    @default("")
  grade          String    @default("")
  sizes          String    @default("")
  finish         String    @default("")
  applications   String    @default("")
  images         Json?
  documents      Json?
  featured       Boolean   @default(false)
  published      Boolean   @default(true)
  seoTitle       String    @default("")
  seoDescription String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  enquiries      Enquiry[]

  @@index([categoryId, published])
  @@index([standard])
  @@index([material])
  @@index([grade])
}

model Enquiry {
  id          String   @id @default(cuid())
  type        String
  name        String
  email       String
  phone       String
  company     String   @default("")
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  requirement String   @default("")
  quantity    String   @default("")
  message     String
  status      String   @default("NEW")
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
}

model Vendor {
  id          String   @id @default(cuid())
  company     String
  contactName String
  email       String
  phone       String
  categories  String
  capability  String
  status      String   @default("NEW")
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Post {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String
  content        String
  image          String    @default("")
  published      Boolean   @default(false)
  publishedAt    DateTime?
  seoTitle       String    @default("")
  seoDescription String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String
  mime      String
  size      Int
  alt       String   @default("")
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String @default("")
}
